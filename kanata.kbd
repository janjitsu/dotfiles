(deflocalkeys-linux
  ro 89
)
(defcfg
  ;; Only target the internal laptop keyboard
  linux-dev-names-include ("AT Translated Set 2 keyboard")
  process-unmapped-keys yes
)


(defalias
  ;; Tap: Space | Hold: Left Control (timeout: 150ms)
  spc-ctrl (tap-hold 150 150 spc lctl)
)

(defalias
  ;; Tap: Enter | Hold: Left Shift (timeout: 150ms)
  ret-shift (tap-hold 150 150 ret lshift)
)

(defalias
  ;; Tap Left Super (fires on release): F13 -> XFCE rofi window switcher | Hold / combo: Super
  ;; tap-hold-release resolves to Super immediately when another key is pressed (Super+h, ...)
  met-f13 (tap-hold-release 200 200 f13 lmet)
)

(defsrc
  spc ralt ro f1 lmet
)


(deflayer default
  @spc-ctrl @ret-shift ralt mlft @met-f13
)

