(deflocalkeys-linux
  ro 89
)
(defcfg
  ;; Only target the internal laptop keyboard
  linux-dev-names-include ("AT Translated Set 2 keyboard")
  process-unmapped-keys yes
)


(defalias
  ;; Tap: Space | Hold: Left Control (timeout: 150ms)
  spc-ctrl (tap-hold 150 150 spc lctl)
)

(defalias
  ;; Tap: Enter | Hold: Left Shift (timeout: 150ms)
  ret-shift (tap-hold 150 150 ret lshift)
)

(defalias
  ;; Tap: c / m | Hold: navigation layer (timeout: 150ms)
  c-lyr (tap-hold 150 150 c (layer-while-held nav))
  m-lyr (tap-hold 150 150 m (layer-while-held nav))
)

;; `ro` exists on the JIS laptop, `prtsc` on the ThinkPad (same physical spot).
;; Each machine only has one of them, so the other entry never fires.
;; Key names are physical (QWERTY) positions; the OS layout is Colemak.
(defsrc
  spc ralt ro prtsc f1 c m h u j k
)


(deflayer default
  @spc-ctrl @ret-shift ralt ralt mlft @c-lyr @m-lyr h u j k
)

;; Arrows on the Colemak h / l / n / e keys (physical h / u / j / k)
(deflayer nav
  _ _ _ _ _ _ _ left up down rght
)
