#!/usr/bin/env python3
"""Tile the active window to a third / two thirds / half of the monitor it is on.

Orientation-aware: on a landscape monitor the screen is split into columns, on a
portrait (rotated) monitor into rows. Panel struts are excluded from the area.

  tile-thirds first|second|third|first2|last2|half-a|half-b|full [--dry-run] [--window ID] [--fake-monitor X,Y,W,H]

  first/second/third = 1st/2nd/3rd third   (left/center/right or top/middle/bottom)
  first2 / last2     = first two / last two thirds
  half-a / half-b    = first / second half  (left,right or top,bottom)
"""
import re
import subprocess
import sys

from Xlib import X, display, protocol, Xatom

SPECS = {  # name -> (start, span) in units of `parts`
    "first": (0, 1, 3), "second": (1, 1, 3), "third": (2, 1, 3),
    "first2": (0, 2, 3), "last2": (1, 2, 3),
    "half-a": (0, 1, 2), "half-b": (1, 1, 2), "full": (0, 1, 1),
}

fake = None
argv = sys.argv[1:]
if "--fake-monitor" in argv:  # testing aid: pretend the monitor has this geometry
    i = argv.index("--fake-monitor")
    fake = [int(v) for v in argv[i + 1].split(",")]
    del argv[i:i + 2]
target = None
if "--window" in argv:  # act on this window id instead of the active one
    i = argv.index("--window")
    target = int(argv[i + 1], 0)
    del argv[i:i + 2]
args = [a for a in argv if not a.startswith("--")]
dry = "--dry-run" in argv
if len(args) != 1 or args[0] not in SPECS:
    sys.exit(__doc__)
start, span, parts = SPECS[args[0]]

d = display.Display()
root = d.screen().root
atom = d.intern_atom


def prop(win, name, typ=X.AnyPropertyType):
    p = win.get_full_property(atom(name), typ)
    return p.value if p else None


def active_window():
    if target:
        return d.create_resource_object("window", target)
    v = prop(root, "_NET_ACTIVE_WINDOW")
    if not v or not v[0]:
        sys.exit("no active window")
    return d.create_resource_object("window", v[0])


def monitors():
    out = subprocess.run(["xrandr", "--listmonitors"], capture_output=True, text=True).stdout
    res = []
    for m in re.finditer(r"(\d+)/\d+x(\d+)/\d+\+(-?\d+)\+(-?\d+)", out):
        w, h, x, y = map(int, m.groups())
        res.append([x, y, w, h])
    return res


def abs_geometry(win):
    g = win.get_geometry()
    t = win.translate_coords(root, 0, 0)  # window origin in root coords
    return -t.x, -t.y, g.width, g.height


def frame_extents(win):
    v = prop(win, "_NET_FRAME_EXTENTS")
    return tuple(v) if v and len(v) == 4 else (0, 0, 0, 0)  # left right top bottom


win = active_window()
# Outer (frame) geometry of the window, to find which monitor holds its center.
l, r, t, b = frame_extents(win)
cx, cy, cw, ch = abs_geometry(win)
cx, cy = cx - l, cy - t
cw, ch = cw + l + r, ch + t + b
mx_, my_ = cx + cw // 2, cy + ch // 2

mons = [fake] if fake else monitors()
if not mons:
    sys.exit("no monitors found")
mon = next((m for m in mons if m[0] <= mx_ < m[0] + m[2] and m[1] <= my_ < m[1] + m[3]), mons[0])
X0, Y0, W, H = mon

# Shrink the monitor rect by panels (managed windows with _NET_WM_STRUT_PARTIAL).
# A strut reserves space from a *screen* edge over a coordinate range, so apply it
# only to the monitors that range actually overlaps.
rg = root.get_geometry()
SW, SH = rg.width, rg.height
clients = prop(root, "_NET_CLIENT_LIST") or []
for wid in clients:
    c = d.create_resource_object("window", wid)
    st = prop(c, "_NET_WM_STRUT_PARTIAL")
    if not st or len(st) < 12:
        continue
    left, right, top, bottom = st[0:4]
    lsy, ley, rsy, rey, tsx, tex, bsx, bex = st[4:12]
    def overlap(a0, a1, b0, b1):
        return a0 <= b1 and b0 <= a1
    if top and overlap(tsx, tex, X0, X0 + W - 1) and Y0 < top:
        d_ = top - Y0
        Y0, H = Y0 + d_, H - d_
    if bottom and overlap(bsx, bex, X0, X0 + W - 1) and Y0 + H > SH - bottom:
        H = (SH - bottom) - Y0
    if left and overlap(lsy, ley, Y0, Y0 + H - 1) and X0 < left:
        d_ = left - X0
        X0, W = X0 + d_, W - d_
    if right and overlap(rsy, rey, Y0, Y0 + H - 1) and X0 + W > SW - right:
        W = (SW - right) - X0

# Also respect the WM-reported work area (covers desktops whose bars aren't strut windows,
# e.g. the GNOME Shell top bar on Xorg).
wa = prop(root, "_NET_WORKAREA")
if wa and len(wa) >= 4 and not fake:
    ax, ay, aw, ah = wa[0], wa[1], wa[2], wa[3]
    nx0, ny0 = max(X0, ax), max(Y0, ay)
    nx1, ny1 = min(X0 + W, ax + aw), min(Y0 + H, ay + ah)
    if nx1 > nx0 and ny1 > ny0:
        X0, Y0, W, H = nx0, ny0, nx1 - nx0, ny1 - ny0

vertical = H > W  # portrait monitor: split into rows instead of columns
if vertical:
    seg = H // parts
    nx, ny, nw, nh = X0, Y0 + start * seg, W, seg * span
    if start + span == parts:
        nh = Y0 + H - ny
else:
    seg = W // parts
    nx, ny, nw, nh = X0 + start * seg, Y0, seg * span, H
    if start + span == parts:
        nw = X0 + W - nx

info = f"monitor {X0},{Y0} {W}x{H} {'portrait->rows' if vertical else 'landscape->columns'} => {nx},{ny} {nw}x{nh}"
if dry:
    print(info)
    sys.exit(0)

# Un-maximize first, otherwise the WM ignores the resize.
def net_wm_state(action, a1, a2=0):
    ev = protocol.event.ClientMessage(
        window=win, client_type=atom("_NET_WM_STATE"), data=(32, [action, a1, a2, 1, 0]))
    root.send_event(ev, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)

net_wm_state(0, atom("_NET_WM_STATE_MAXIMIZED_VERT"), atom("_NET_WM_STATE_MAXIMIZED_HORZ"))
net_wm_state(0, atom("_NET_WM_STATE_FULLSCREEN"))
d.sync()

# _NET_MOVERESIZE_WINDOW with StaticGravity (client coords): turn frame rect into client rect.
fl, fr, ft, fb = frame_extents(win)
gx, gy, gw, gh = nx + fl, ny + ft, max(nw - fl - fr, 1), max(nh - ft - fb, 1)
flags = 10 | (1 << 8) | (1 << 9) | (1 << 10) | (1 << 11) | (2 << 12)
ev = protocol.event.ClientMessage(
    window=win, client_type=atom("_NET_MOVERESIZE_WINDOW"), data=(32, [flags, gx, gy, gw, gh]))
root.send_event(ev, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)
d.sync()
