#!/usr/bin/env python3
"""Play the freedesktop sound theme's bell instead of the raw X speaker beep.

GNOME (mutter) did this itself; XFCE does not, so terminals (Ptyxis etc.) fall
back to the X server's PC-speaker-style beep. This listens for XKB BellNotify
events, turns the server's own audible bell off (XkbAudibleBell control), and
plays 'bell-window-system' through libcanberra. Uses ctypes + libX11 only.
"""
import ctypes
import ctypes.util
import subprocess
import sys
import time

XKB_USE_CORE_KBD = 0x0100
XKB_BELL_NOTIFY_MASK = 1 << 8
XKB_AUDIBLE_BELL_MASK = 1 << 9

x11 = ctypes.CDLL(ctypes.util.find_library("X11"))
x11.XOpenDisplay.restype = ctypes.c_void_p
x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
x11.XNextEvent.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
x11.XkbQueryExtension.argtypes = [ctypes.c_void_p] + [ctypes.POINTER(ctypes.c_int)] * 5
x11.XkbSelectEvents.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_ulong, ctypes.c_ulong]
x11.XkbChangeEnabledControls.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_uint, ctypes.c_uint]
x11.XFlush.argtypes = [ctypes.c_void_p]

dpy = x11.XOpenDisplay(None)
if not dpy:
    sys.exit("cannot open X display")

opcode, event_base, error_base, major, minor = (ctypes.c_int() for _ in range(5))
major.value, minor.value = 1, 0
if not x11.XkbQueryExtension(dpy, *(ctypes.byref(v) for v in (opcode, event_base, error_base, major, minor))):
    sys.exit("XKB extension not available")

x11.XkbSelectEvents(dpy, XKB_USE_CORE_KBD, XKB_BELL_NOTIFY_MASK, XKB_BELL_NOTIFY_MASK)
# Server stops beeping itself but still delivers BellNotify to us.
x11.XkbChangeEnabledControls(dpy, XKB_USE_CORE_KBD, XKB_AUDIBLE_BELL_MASK, 0)
x11.XFlush(dpy)

buf = (ctypes.c_long * 24)()  # >= sizeof(XEvent)
last = 0.0
while True:
    x11.XNextEvent(dpy, buf)
    if ctypes.c_int.from_buffer(buf).value != event_base.value:
        continue
    now = time.monotonic()
    if now - last < 0.15:  # debounce bursts
        continue
    last = now
    subprocess.Popen(
        ["canberra-gtk-play", "-i", "bell-window-system"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
